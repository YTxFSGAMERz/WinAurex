---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default {...Astro.props}><slot /></Default>

<!-- Custom WinAurex Cyberpunk Global Footer (2026 Edition) -->
<footer class="winaurex-global-footer" role="contentinfo" aria-label="WinAurex Site Footer">
  <div class="footer-grid">
    <!-- Column 1: Brand & Identity -->
    <div class="footer-col brand-col">
      <div class="footer-logo">
        <span class="hud-glitch-text" data-text="WINAUREX">WINAUREX</span>
        <span class="footer-version-tag">v1.2.0 • 2026</span>
      </div>
      <p class="footer-tagline">
        Zero-Bloat Windows 11 Image Engineering, Live Kernel Scheduling & Unattended Optimization Framework.
      </p>
      <div class="footer-badges">
        <span class="footer-status-pill">
          <span class="hud-status-dot" aria-hidden="true"></span>
          ENGINE ONLINE
        </span>
        <span class="footer-status-pill">100% OPEN SOURCE</span>
      </div>
    </div>

    <!-- Column 2: Products & Tools -->
    <div class="footer-col">
      <h3 class="footer-col-title">PRODUCTS & TOOLS</h3>
      <ul class="footer-links">
        <li><a href="/studio/">Interactive Web Studio</a></li>
        <li><a href="/os_builder/">OS Image Builder</a></li>
        <li><a href="/autounattend/">Unattended XML Generator</a></li>
        <li><a href="/dashboard_architecture/">C# WPF Desktop GUI</a></li>
        <li><a href="/tweaks/">Live System Tweaks</a></li>
      </ul>
    </div>

    <!-- Column 3: Documentation & Deep Dives -->
    <div class="footer-col">
      <h3 class="footer-col-title">RESOURCES & RESEARCH</h3>
      <ul class="footer-links">
        <li><a href="/architecture_blueprint/">Architecture Blueprint</a></li>
        <li><a href="/compatibility_matrix/">OS Compatibility Matrix</a></li>
        <li><a href="/input_latency_myths/">Input Latency Myths & Facts</a></li>
        <li><a href="/myths_and_anti_patterns/">Myths & Anti-Patterns</a></li>
        <li><a href="/registry_reference/">Registry Reference</a></li>
        <li><a href="/faq/">Frequently Asked Questions</a></li>
      </ul>
    </div>

    <!-- Column 4: Community & Legal -->
    <div class="footer-col">
      <h3 class="footer-col-title">COMMUNITY & LEGAL</h3>
      <ul class="footer-links">
        <li><a href="https://github.com/YTxFSGAMERz/WinAurex" target="_blank" rel="noopener noreferrer">GitHub Repository ↗</a></li>
        <li><a href="https://t.me/YTxFSGAMERz" target="_blank" rel="noopener noreferrer">Telegram Community ↗</a></li>
        <li><a href="https://wa.me/917778906798" target="_blank" rel="noopener noreferrer">WhatsApp Support ↗</a></li>
        <li><a href="/contact/">Contact & Vulnerability Reporting</a></li>
        <li><a href="/privacy/">Privacy Policy (GDPR/CCPA)</a></li>
        <li><a href="/terms/">Terms of Service & License</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom-bar">
    <div class="footer-copy">
      &copy; {new Date().getFullYear()} WinAurex. Built with <span style="color: #00ff00;">♥</span> by <a href="https://github.com/YTxFSGAMERz" target="_blank" rel="noopener noreferrer">Farhan (YTxFSGAMERz)</a>.
    </div>
    <div class="footer-disclaimer">
      Zero Telemetry • No Third-Party Spyware • Distributed under the ISC / MIT License.
    </div>
  </div>
</footer>
