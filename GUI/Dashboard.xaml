                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource Header2}" Text="Transaction Details" Margin="0,0,0,8"/>
                                        <Border Background="#0d1117" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6" Padding="14" Height="260">
                                            <ScrollViewer>
                                                <TextBlock Name="TxtTransactionDetails" Style="{StaticResource BodyText}" Text="Select a transaction to preview changes..."/>
                                            </ScrollViewer>
                                        </Border>
                                        <Button Name="BtnRollbackSelected" Style="{StaticResource DangerButton}" Content="Rollback Selected Transaction" Margin="0,10,0,0" Height="36" IsEnabled="False"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource Header2}" Text="Third-Party Modification Detector" Margin="0,0,0,4"/>
                                        <TextBlock Style="{StaticResource BodyText}" Text="Audit registry for unauthorized changes outside the WinAurex transaction engine."/>
                                    </StackPanel>
                                    <Button Name="BtnDetectThirdParty" Grid.Column="1" Content="Detect Changes" Height="32"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>

        <!-- 3. FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="v5.5 Extreme Edition" Foreground="#6e7681" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <Button Name="BtnOpenLogsFolder" Height="22" Padding="8,0" Background="#21262d" Foreground="#00adb5" BorderBrush="#30363d" BorderThickness="1" FontSize="10" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xED25;" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="10"/>
                            <TextBlock Text="View Logs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="TxtProgressDetail" Grid.Column="0" Text="" Foreground="#8b949e" FontSize="11" Margin="0,0,10,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                    <ProgressBar Name="ProgressGlobal" Grid.Column="1" Height="6" Background="#21262d" Foreground="#00adb5" Value="0" Maximum="100" BorderThickness="0" Visibility="Collapsed" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Name="TxtStatus" Grid.Column="2" Style="{StaticResource BodyText}" Text="Status: Ready" Foreground="#00adb5" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- PROMINENT ASYNC LOADING & PROGRESS OVERLAY (GLASSMORPHIC HUD) -->
        <!-- ============================================================== -->
        <Grid Name="OverlayAsyncLoading" Grid.RowSpan="3" Background="#EE0d1117" Visibility="Collapsed" Panel.ZIndex="9999">
            <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Background="#161b22" BorderBrush="#00adb5" BorderThickness="1.5" CornerRadius="12" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#00adb5" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Glowing Icon / Pulse Ring -->
                    <Border Name="BorderOverlayIconRing" Width="64" Height="64" CornerRadius="32" Background="#1f2d3d" BorderBrush="#00adb5" BorderThickness="2" Margin="0,0,0,16" HorizontalAlignment="Center">
                        <TextBlock Name="TxtOverlayIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE768;" FontSize="28" Foreground="#00adb5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Action Title -->
                    <TextBlock Name="TxtOverlayTitle" Text="EXECUTIVE SYSTEM BOOST IN PROGRESS" FontSize="16" FontWeight="Bold" Foreground="#ffffff" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    
                    <!-- Subtitle / Stage -->
                    <TextBlock Name="TxtOverlaySubtitle" Text="Optimizing background services, memory pages, and latency policies..." FontSize="12" Foreground="#8b949e" HorizontalAlignment="Center" Margin="0,0,0,18" TextWrapping="Wrap" TextAlignment="Center"/>

                    <!-- Prominent Animated Progress Bar -->
                    <ProgressBar Name="ProgressOverlay" Height="8" Width="480" Background="#21262d" Foreground="#00adb5" IsIndeterminate="True" BorderThickness="0" Margin="0,0,0,12"/>

                    <!-- Live Real-Time Detail Text -->
                    <Border Background="#0d1117" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6" Padding="12,8" Width="480" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Name="TxtOverlayDetail" Grid.Column="0" Text="Initializing optimization engine..." Foreground="#00adb5" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Name="TxtOverlayElapsed" Grid.Column="1" Text="0.0s" Foreground="#8b949e" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Responsive State Badge -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#00ff41" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="BACKGROUND WORKER ACTIVE • SYSTEM FULLY RESPONSIVE" Foreground="#8b949e" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
